; Демо-записи (attract mode): 8 записей, по кругу через demo_index (cmpi.w #8).
; demo_entry поток, уровень - 6 байт: указатель на поток и selectedLevelOption.
; Поток (sub_24D5C0 воспроизводит, sub_24D4AC записывает при demo_mode = 2):
;   demo_start  - 4 слова, читаются в word_FFFF90..96 и игрой не используются. Рекордер
;                 пишет туда то, что лежало в word_FFFF90..96 (формат начала level_config:
;                 старт Джима X/Y, камеры X/Y); почти везде это значения New Junk City
;   demo_pad N, кнопки - N кадров (1..256) держать кнопки (PAD_* через +, PAD_NONE - ничего)
;   demo_end    - конец записи, демо переходит к следующему
; Запись ограничена $A8C = 2700 кадрами (word_FFFF8C), отсюда ~2700 кадров в каждом демо.
demo_table:
                demo_entry demo_new_junk_city,    $00   ; New Junk City
                demo_entry demo_what_the_heck,    $01   ; What the Heck?
                demo_entry demo_snot_a_problem,   $06   ; Snot a Problem (3C)
                demo_entry demo_for_petes_sake,   $07   ; For Pete's Sake
                demo_entry demo_buttville,        $09   ; Buttville
                demo_entry demo_level_5,          $0B   ; Level 5 (2-я секция)
                demo_entry demo_down_the_tubes,   $0F   ; Down the Tubes (2-я секция)
                demo_entry demo_andy_asteroids,   $10   ; Andy Asteroids

